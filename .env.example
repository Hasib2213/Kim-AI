APP_ENV=development
DEBUG=true
API_SECRET=change-me
CORS_ORIGINS=["http://localhost:3000"]

# Local docker defaults work as-is
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=property_ai

# Core AI
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_VISION_MODEL=gpt-6-luna

# Optional future AI providers (adapters can be added without changing business code)
GEMINI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# Retell AI calling
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
RETELL_WEBHOOK_SECRET=

# Vapi alternative
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v24.0

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

MEDIA_DIR=./storage
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
